{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/home",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/about",
      "destination": "/studio",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/studio",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/services.html",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/service-automation",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/service-automation.html",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/service-content",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/service-content.html",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/service-training",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/service-training.html",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/service-social",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/service-social.html",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/service-marketing",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/service-marketing.html",
      "destination": "/#services",
      "permanent": true
    },
